APP_NAME="Travel with Coen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# SQLite locally; on the server e.g. mysql with DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD
DB_CONNECTION=sqlite

# Admin account created by `php artisan db:seed`
ADMIN_NAME="Coen"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret for devices/apps posting tracking points (POST /api/tracking). Empty = disabled.
TRACKING_INGEST_TOKEN=

# YouTube channel whose newest videos appear in the gallery (URL, @handle or channel id)
YOUTUBE_CHANNEL=

# Optional: path to ffmpeg, used to strip location data from uploaded videos (default: ffmpeg)
# FFMPEG_PATH=ffmpeg

# How long a login stays valid without activity, in minutes (10080 = 7 days)
SESSION_LIFETIME=10080

# Media storage: true = Cloudflare R2 (fill in the R2_ values), false = local disk
R2_ENABLED=false
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_URL=https://media.example.com

# IP addresses that see the full site while it is closed (Settings > Website access). Logged-in admins always do.
PREVIEW_IPS=127.0.0.1,::1

# Behind Cloudflare or another proxy: "*" (only when the server is reachable through that proxy only). See DEPLOYMENT.md.
# TRUSTED_PROXIES=*

# E-mail (password reset). See DEPLOYMENT.md.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# Garmin inReach via MapShare (see DEPLOYMENT.md): e.g. https://share.garmin.com/Feed/Share/YourMapShareName
# GARMIN_MAPSHARE_URL=
# GARMIN_MAPSHARE_PASSWORD=

# Automatic translations (Google Cloud Translation API key)
GOOGLE_TRANSLATE_KEY=
# Google Analytics 4 measurement ID (G-...); empty = off
GOOGLE_ANALYTICS_ID=
